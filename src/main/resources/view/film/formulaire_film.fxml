<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="700.0" prefWidth="950.0" styleClass="root-layout" stylesheets="@../../assets/films.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FilmControleur">
  <left>
    <fx:include fx:id="sidebar" source="../layout/sidebar.fxml"/>
  </left>

  <center>
    <ScrollPane fitToWidth="true" styleClass="content-scroll" BorderPane.alignment="CENTER">
      <content>
        <VBox spacing="18.0" styleClass="main-content">
          <children>
            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
              <children>
                <VBox spacing="2.0">
                  <children>
                    <Text fx:id="txtTitrePage" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Ajouter un film"/>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-subtitle" text="Complétez les informations relatives à l'œuvre"/>
                  </children>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onAnnuler" styleClass="btn-secondary" text="Retour à la liste"/>
              </children>
            </HBox>
            <!-- Formulaire structuré en carte blanche -->
            <VBox maxWidth="780.0" spacing="18.0" styleClass="content-box">
              <children>
                <Label styleClass="box-title" text="Informations générales"/>
                <GridPane hgap="16.0" vgap="14.0">
                  <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="360.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="360.0"/>
                  </columnConstraints>
                  <rowConstraints>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                  </rowConstraints>
                  <children>
                    <!-- Titre du film (pleine largeur) -->
                    <VBox spacing="4.0" GridPane.columnSpan="2">
                      <children>
                        <Label styleClass="field-label" text="Titre du film *"/>
                        <TextField fx:id="txtTitre" promptText="Ex: Inception" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Genre -->
                    <VBox spacing="4.0" GridPane.rowIndex="1">
                      <children>
                        <Label styleClass="field-label" text="Genre *"/>
                        <ComboBox fx:id="cbFormGenre" maxWidth="1.7976931348623157E308" promptText="Sélectionnez un genre" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Durée en minutes -->
                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                      <children>
                        <Label styleClass="field-label" text="Durée (en minutes) *"/>
                        <TextField fx:id="txtDuree" promptText="Ex: 148" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Date de sortie -->
                    <VBox spacing="4.0" GridPane.rowIndex="2">
                      <children>
                        <Label styleClass="field-label" text="Date de sortie nationale *"/>
                        <DatePicker fx:id="dpDateSortie" maxWidth="1.7976931348623157E308" promptText="JJ/MM/AAAA" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Âge minimum -->
                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                      <children>
                        <Label styleClass="field-label" text="Âge minimum requis (années)"/>
                        <TextField fx:id="txtAgeMinimum" promptText="Ex: 12 (0 pour tous publics)" styleClass="form-input"/>
                      </children>
                    </VBox>
                  </children>
                </GridPane>
                <!-- Langue -->
                <VBox spacing="4.0">
                  <children>
                    <Label styleClass="field-label" text="Langue de projection *"/>
                    <TextField fx:id="txtLangue" promptText="Ex: Français (VF), Version originale sous-titrée (VOSTFR)" styleClass="form-input"/>
                  </children>
                </VBox>
                <!-- Synopsis -->
                <VBox spacing="4.0">
                  <children>
                    <Label styleClass="field-label" text="Synopsis &amp; Résumé"/>
                    <TextArea fx:id="txtSynopsis" prefHeight="110.0" promptText="Courte description du scénario du film..." styleClass="form-input" wrapText="true"/>
                  </children>
                </VBox>
                <!-- Message d'erreur ou de succès -->
                <Label fx:id="lblMessage" managed="false" styleClass="field-label" text="" visible="false"/>
                <!-- Boutons d'enregistrement -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                  <children>
                    <Button mnemonicParsing="false" onAction="#onAnnuler" styleClass="btn-secondary" text="Annuler"/>
                    <Button fx:id="btnEnregistrer" mnemonicParsing="false" onAction="#onEnregistrer" styleClass="btn-primary" text="Enregistrer le film"/>
                  </children>
                  <VBox.margin>
                    <Insets top="8.0"/>
                  </VBox.margin>
                </HBox>
              </children>
            </VBox>
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
