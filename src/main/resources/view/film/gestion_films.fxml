<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" styleClass="root-layout" stylesheets="@../../assets/films.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FilmControleur">
  <left>
    <fx:include fx:id="sidebar" source="../layout/sidebar.fxml"/>
  </left>

  <center>
    <ScrollPane fitToWidth="true" styleClass="content-scroll" BorderPane.alignment="CENTER">
      <content>
        <VBox spacing="16.0" styleClass="main-content">
          <children>
            <!-- En-tête : Titre & Actions principales -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
              <children>
                <VBox spacing="2.0">
                  <children>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Gestion des films"/>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-subtitle" text="Catalogue des œuvres à l'affiche et programmées"/>
                  </children>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnModifierFilm" mnemonicParsing="false" onAction="#onModifierFilm" styleClass="btn-secondary" text="Modifier la sélection"/>
                <Button fx:id="btnSupprimerFilm" mnemonicParsing="false" onAction="#onSupprimerFilm" styleClass="btn-danger" text="Supprimer"/>
                <Button fx:id="btnNouveauFilm" mnemonicParsing="false" onAction="#onNouveauFilm" styleClass="btn-primary" text="Nouveau film"/>
              </children>
            </HBox>
            <!-- Barre de recherche et de filtres -->
            <VBox spacing="10.0" styleClass="content-box">
              <children>
                <Label styleClass="box-title" text="Filtres et recherche"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <children>
                    <!-- Recherche Titre -->
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label styleClass="field-label" text="Titre du film"/>
                        <TextField fx:id="txtRecherche" promptText="Rechercher par titre..." styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Filtre Genre -->
                    <VBox prefWidth="180.0" spacing="4.0">
                      <children>
                        <Label styleClass="field-label" text="Genre"/>
                        <ComboBox fx:id="cbGenre" maxWidth="1.7976931348623157E308" promptText="Tous les genres" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Filtre Langue -->
                    <VBox prefWidth="140.0" spacing="4.0">
                      <children>
                        <Label styleClass="field-label" text="Langue"/>
                        <ComboBox fx:id="cbLangue" maxWidth="1.7976931348623157E308" promptText="Toutes" styleClass="form-input"/>
                      </children>
                    </VBox>
                    <!-- Boutons de filtrage -->
                    <VBox alignment="BOTTOM_LEFT" spacing="4.0">
                      <children>
                        <HBox spacing="8.0">
                          <children>
                            <Button fx:id="btnRechercher" mnemonicParsing="false" onAction="#onRechercher" styleClass="btn-primary" text="Filtrer"/>
                            <Button fx:id="btnReinitialiser" mnemonicParsing="false" onAction="#onReinitialiser" styleClass="btn-secondary" text="Réinitialiser"/>
                          </children>
                        </HBox>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>
            <!-- Tableau des films -->
            <VBox spacing="8.0" styleClass="content-box" VBox.vgrow="ALWAYS">
              <children>
                <HBox alignment="CENTER_LEFT">
                  <children>
                    <Label styleClass="box-title" text="Liste des films enregistrés"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalFilms" styleClass="page-subtitle" text="4 films enregistrés"/>
                  </children>
                </HBox>
                <TableView fx:id="tableFilms" minHeight="340.0" prefHeight="400.0" VBox.vgrow="ALWAYS">
                  <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                    <TableColumn fx:id="colTitre" prefWidth="250.0" text="Titre"/>
                    <TableColumn fx:id="colGenre" prefWidth="130.0" text="Genre"/>
                    <TableColumn fx:id="colDuree" prefWidth="90.0" text="Durée"/>
                    <TableColumn fx:id="colDateSortie" prefWidth="120.0" text="Date de sortie"/>
                    <TableColumn fx:id="colAgeMin" prefWidth="80.0" text="Âge min."/>
                    <TableColumn fx:id="colLangue" prefWidth="90.0" text="Langue"/>
                  </columns>
                  <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                  </columnResizePolicy>
                </TableView>
              </children>
            </VBox>
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
